{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./app/*"],
      "@assets/*": ["./assets/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "app/**/*",
    "test/**/*",
    "jest.setup.ts"
  ]
}
